---
import { Image } from "astro:assets";
import desktopOverview from "../../assets/product-screenshots/hero/overview-desktop.jpg";
import mobileBooking from "../../assets/product-screenshots/hero/booking-mobile.jpg";
import heroCharacter from "../../assets/generated/hero/hero-character.png";
import heroWater from "../../assets/generated/hero/hero-water-background.png";
import heroWaterMobile from "../../assets/generated/hero/hero-water-background-mobile.png";
import headlineAccent from "../../assets/generated/hero/headline-accent-marks.png";
import mainSpark from "../../assets/generated/hero/hero-main-spark.png";
import speechBubble from "../../assets/generated/hero/speech-bubble-shape.png";
import speechBubbleSpark from "../../assets/generated/hero/speech-bubble-spark.png";

interface Props {
  locale: "ar" | "en";
}

const { locale } = Astro.props;
const isArabic = locale === "ar";

const copy = isArabic
  ? {
      eyebrow: "نظام إدارة متكامل لمغاسل السيارات",
      headline: ["مش لازم تفضل", "في المغسلة عشان", "تكون مسيطر عليها."],
      descriptionLead:
        "Sparkle Auto بيجمع تشغيل مغسلتك في مكان واحد: الحجوزات، حالة العربيات، الفريق، المخزون، الإيرادات والعملاء.",
      descriptionPivot: "بدل المكالمات والتقارير المتفرقة:",
      descriptionClose: "افتح واعرف إيه اللي بيحصل في مغسلتك حتى لو إنت بعيد.",
      primaryCta: "احجز مراجعة تشغيل لفروعك",
      secondaryCta: "شوف السيستم وهو شغال",
      productCaption: "مغسلتك في جيبك.",
      desktopAlt:
        "شاشة الـOverview الحقيقية في Sparkle Auto وتعرض الحجوزات والإيرادات وحالة تشغيل المغسلة",
      mobileAlt: "شاشة الحجز الحقيقية للعملاء في Sparkle Auto وتعرض اختيار التاريخ والموعد",
    }
  : {
      eyebrow: "Complete Management System for Car Washes",
      headline: ["You don't have to", "stay at the wash to", "stay in control."],
      descriptionLead:
        "Sparkle Auto brings your bookings, car status, team, inventory, revenue, and customers into one place.",
      descriptionPivot: "Instead of scattered calls and reports:",
      descriptionClose:
        "Open the system and know what's happening at your car wash — even when you're away.",
      primaryCta: "Book an Operations Review for Your Branches",
      secondaryCta: "See the System in Action",
      productCaption: "Your car wash in your pocket.",
      desktopAlt:
        "The real Sparkle Auto Overview screen showing bookings, revenue, and car-wash operations",
      mobileAlt:
        "The real Sparkle Auto customer booking screen showing date and appointment selection",
    };

const localeRoot = isArabic ? "/" : "/en/";
---

<section class="hero" aria-labelledby="hero-title">
  <picture aria-hidden="true">
    <source media="(max-width: 56rem)" srcset={heroWaterMobile.src} />
    <img
      class="hero__water"
      src={heroWater.src}
      alt=""
      width={heroWater.width}
      height={heroWater.height}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </picture>

  <div class="hero__canvas">
    <div class="hero__content" dir={isArabic ? "rtl" : "ltr"}>
      <p class="hero__eyebrow">{copy.eyebrow}</p>

      <div class="hero__headline-wrap">
        <h1 class="hero__headline" id="hero-title">
          <span>{copy.headline[0]}</span>
          <span>{copy.headline[1]}</span>
          <span class="hero__headline-highlight">{copy.headline[2]}</span>
        </h1>
        <Image
          class="hero__headline-accent"
          src={headlineAccent}
          alt=""
          format="webp"
          quality={100}
          loading="eager"
          decoding="async"
          aria-hidden="true"
        />
      </div>

      <div class="hero__description">
        <p>{copy.descriptionLead}</p>
        <p><strong>{copy.descriptionPivot}</strong></p>
        <p>{copy.descriptionClose}</p>
      </div>

      <div class="hero__actions">
        <a class="hero__button hero__button--primary" href={`${localeRoot}#application`} dir={isArabic ? "rtl" : "ltr"}>
          {copy.primaryCta}
        </a>
        <a class="hero__button hero__button--secondary" href="#hero-product" dir={isArabic ? "rtl" : "ltr"}>
          <span>{copy.secondaryCta}</span>
          <span class="hero__button-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <figure class="hero__visual" id="hero-product" aria-label={copy.productCaption}>
      <Image
        class="hero__main-spark"
        src={mainSpark}
        alt=""
        format="webp"
        quality={100}
        loading="lazy"
        decoding="async"
        aria-hidden="true"
      />

      <div class="hero__laptop">
        <div class="hero__laptop-lid">
          <Image
            class="hero__desktop-screen"
            src={desktopOverview}
            alt={copy.desktopAlt}
            format="webp"
            quality={94}
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="hero__laptop-base" aria-hidden="true">
          <span></span>
        </div>
      </div>

      <Image
        class="hero__character"
        src={heroCharacter}
        alt=""
        format="webp"
        quality={94}
        loading="lazy"
        decoding="async"
        aria-hidden="true"
      />

      <div class="hero__phone">
        <span class="hero__phone-speaker" aria-hidden="true"></span>
        <Image
          class="hero__mobile-screen"
          src={mobileBooking}
          alt={copy.mobileAlt}
          format="webp"
          quality={94}
          loading="eager"
          decoding="async"
        />
      </div>

      <div class="hero__speech" role="img" aria-label="Run it Smarter.">
        <Image
          class="hero__speech-shape"
          src={speechBubble}
          alt=""
          format="webp"
          quality={100}
          loading="lazy"
          decoding="async"
          aria-hidden="true"
        />
        <span class="hero__speech-copy" aria-hidden="true">Run it<br />Smarter.</span>
      </div>

      <Image
        class="hero__speech-spark"
        src={speechBubbleSpark}
        alt=""
        format="webp"
        quality={100}
        loading="lazy"
        decoding="async"
        aria-hidden="true"
      />

      <figcaption class="hero__product-caption">{copy.productCaption}</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    margin-block-start: -8.5rem;
    overflow: hidden;
    background: #fcfeff;
    isolation: isolate;
  }

  .hero__water {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: fill;
    pointer-events: none;
    user-select: none;
  }

  .hero__canvas {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 96rem;
    min-height: 100svh;
    margin-inline: auto;
    direction: ltr;
  }

  .hero__content {
    position: absolute;
    z-index: 12;
    top: 17.13%;
    left: 4.1667%;
    display: flex;
    width: 32.62%;
    flex-direction: column;
    align-items: flex-start;
    color: var(--deep-navy);
    text-align: start;
  }

  .hero__eyebrow {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    margin: 0;
    padding: 0.55rem 0.85rem;
    border: 2px solid var(--spark-blue);
    border-radius: var(--radius-control);
    background: var(--white);
    box-shadow: var(--shadow-1);
    color: var(--accent-blue-aa);
    font-size: clamp(0.84rem, 1.17vw, 1.125rem);
    font-weight: 800;
    line-height: 1.2;
    white-space: nowrap;
  }

  .hero__headline-wrap {
    position: relative;
    width: 100%;
  }

  .hero__headline {
    margin: 0.9rem 0 0;
    color: var(--deep-navy);
    font-size: clamp(2.15rem, 3.52vw, 3.375rem);
    font-weight: 900;
    letter-spacing: -0.035em;
    line-height: 1.06;
  }

  .hero__headline span {
    display: block;
    white-space: nowrap;
  }

  .hero__headline-highlight {
    color: var(--spark-blue);
  }

  .hero__headline-accent {
    position: absolute;
    z-index: 13;
    top: 0.65rem;
    left: 100%;
    width: 2.75rem;
    height: 3.125rem;
    object-fit: fill;
    pointer-events: none;
  }

  .hero__description {
    width: 88%;
    margin-block-start: 1.25rem;
    color: var(--ink-muted);
    font-size: clamp(0.9rem, 1.08vw, 1.04rem);
    font-weight: 520;
    line-height: 1.42;
  }

  .hero__description p {
    margin: 0;
  }

  .hero__description p + p {
    margin-block-start: 0.2rem;
  }

  .hero__description strong {
    color: var(--deep-navy);
    font-weight: 800;
  }

  .hero__actions {
    display: flex;
    width: 100%;
    align-items: stretch;
    gap: 1.375rem;
    margin-block-start: 2rem;
    direction: ltr;
  }

  .hero__button {
    display: inline-flex;
    min-height: 3.75rem;
    flex: 1 1 0;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 0.75rem 0.9rem;
    border: var(--border-default) solid var(--deep-navy);
    border-radius: var(--radius-button);
    color: var(--deep-navy);
    font-size: clamp(0.78rem, 0.91vw, 0.88rem);
    font-weight: 850;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    transition:
      transform var(--motion-micro) var(--ease-standard),
      box-shadow var(--motion-micro) var(--ease-standard),
      background-color var(--motion-micro) var(--ease-standard);
  }

  .hero__button--primary {
    background: var(--spark-blue);
    box-shadow: var(--shadow-2);
  }

  .hero__button--secondary {
    background: var(--white);
    box-shadow: var(--shadow-1);
  }

  .hero__button:hover {
    background: var(--fresh-blue);
    transform: translate(-1px, -1px);
  }

  .hero__button:active {
    box-shadow: none;
    transform: translate(4px, 4px);
  }

  .hero__button:focus-visible {
    outline: 3px solid var(--deep-navy);
    outline-offset: 4px;
  }

  .hero__button-arrow {
    font-family: "Nunito Variable", Nunito, system-ui, sans-serif;
    font-size: 1.5em;
    line-height: 0;
  }

  .hero__visual {
    position: absolute;
    z-index: 2;
    inset: 0;
    margin: 0;
    direction: ltr;
    pointer-events: none;
  }

  .hero__main-spark {
    position: absolute;
    z-index: 4;
    inset-block-start: 15.4%;
    inset-inline-start: 72.79%;
    width: 2.22%;
    height: 4.98%;
    object-fit: fill;
  }

  .hero__laptop {
    position: absolute;
    z-index: 5;
    inset-block-start: 34.26%;
    inset-inline-start: 37.96%;
    width: 44.21%;
    animation: hero-stage-in 620ms var(--ease-standard) both;
  }

  .hero__laptop-lid {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1.68;
    padding: 0.55rem;
    border: 4px solid var(--deep-navy);
    border-radius: 0.9rem 0.9rem 0.35rem 0.35rem;
    background: #071a3f;
  }

  .hero__desktop-screen {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 0.38rem;
    object-fit: cover;
    object-position: center;
  }

  .hero__laptop-base {
    position: relative;
    width: 106%;
    aspect-ratio: 23 / 1;
    margin-inline-start: -3%;
    border: 3px solid var(--deep-navy);
    border-radius: 0.2rem 0.2rem 1rem 1rem;
    background: #dce7ee;
  }

  .hero__laptop-base span {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 42%;
    width: 16%;
    height: 34%;
    border: 2px solid var(--deep-navy);
    border-block-start: 0;
    border-radius: 0 0 0.35rem 0.35rem;
    background: #f7fbfd;
  }

  .hero__character {
    position: absolute;
    z-index: 6;
    inset-block-start: 10.42%;
    inset-inline-start: 71.09%;
    width: 23.44%;
    height: auto;
    object-fit: contain;
    animation: hero-stage-in 620ms 90ms var(--ease-standard) both;
  }

  .hero__phone {
    position: absolute;
    z-index: 8;
    inset-block-start: 48.38%;
    inset-inline-start: 75.39%;
    overflow: hidden;
    width: 9.77%;
    aspect-ratio: 150 / 352;
    padding: 0.35rem;
    border: 4px solid var(--deep-navy);
    border-radius: 1.65rem;
    background: #071a3f;
    box-shadow: var(--shadow-1);
    animation: hero-stage-in 620ms 140ms var(--ease-standard) both;
  }

  .hero__phone-speaker {
    position: absolute;
    z-index: 2;
    inset-block-start: 0.55rem;
    inset-inline-start: 50%;
    width: 34%;
    height: 0.5rem;
    border-radius: 999px;
    background: #071a3f;
    transform: translateX(-50%);
  }

  .hero__mobile-screen {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 1.15rem;
    object-fit: cover;
    object-position: center top;
  }

  .hero__speech {
    position: absolute;
    z-index: 9;
    inset-block-start: 13.08%;
    inset-inline-start: 88.87%;
    width: 8.59%;
    aspect-ratio: 132 / 82;
    animation: hero-sticker-in 420ms 260ms var(--ease-standard) both;
  }

  .hero__speech-shape {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: fill;
  }

  .hero__speech-copy {
    position: absolute;
    z-index: 1;
    inset-block-start: 21%;
    inset-inline: 12% 8%;
    color: #03132e;
    direction: ltr;
    font-family: "Nunito Variable", Nunito, system-ui, sans-serif;
    font-size: clamp(0.7rem, 1.3vw, 1.25rem);
    font-weight: 950;
    letter-spacing: -0.045em;
    line-height: 0.9;
    text-align: center;
  }

  .hero__speech-spark {
    position: absolute;
    z-index: 11;
    inset-block-start: 12.5%;
    inset-inline-start: 95.57%;
    width: 1.83%;
    height: 4.28%;
    object-fit: fill;
    animation: hero-sticker-in 420ms 330ms var(--ease-standard) both;
  }

  .hero__product-caption {
    position: absolute;
    z-index: 10;
    top: 86.5%;
    left: 43.8%;
    width: 19.5%;
    color: var(--spark-blue);
    direction: rtl;
    font-size: clamp(0.92rem, 1.3vw, 1.25rem);
    font-weight: 850;
    text-align: center;
  }

  html[lang="en"] .hero__product-caption {
    direction: ltr;
  }

  @keyframes hero-stage-in {
    from {
      opacity: 0;
      transform: translateY(1rem) scale(0.985);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes hero-sticker-in {
    from {
      opacity: 0;
      transform: translateY(0.35rem) rotate(-2deg);
    }
    to {
      opacity: 1;
      transform: translateY(0) rotate(0);
    }
  }

  @media (min-width: 56.01rem) and (max-width: 75rem) {
    .hero {
      min-height: 56.25vw;
    }

    .hero__canvas {
      min-height: 56.25vw;
    }

    .hero__eyebrow {
      min-height: 2.35rem;
    }

    .hero__actions {
      gap: 0.9rem;
      margin-block-start: 0.85rem;
    }

    .hero__button {
      min-height: 3.2rem;
      padding-inline: 0.55rem;
    }

    .hero__description {
      margin-block-start: 0.8rem;
      line-height: 1.32;
    }
  }

  @media (max-width: 56rem) {
    .hero {
      min-height: auto;
      margin-block-start: -5.5rem;
      padding-block-start: 5.5rem;
    }

    .hero__canvas {
      display: flex;
      min-height: 0;
      flex-direction: column;
      gap: 2rem;
      padding: 1.5rem 1.25rem 3rem;
    }

    .hero__content {
      position: relative;
      inset: auto;
      width: 100%;
      max-width: 40rem;
      margin-inline: auto;
    }

    .hero__eyebrow {
      min-height: 2.75rem;
      max-width: 100%;
      font-size: 0.88rem;
      white-space: normal;
    }

    .hero__headline {
      margin-block-start: 1.1rem;
      font-size: clamp(2.25rem, 10.8vw, 3.25rem);
      line-height: 1.1;
    }

    .hero__headline-accent {
      inset-block-start: 0.25rem;
      inset-inline-start: auto;
      inset-inline-end: -0.25rem;
      width: 2rem;
      height: 2.25rem;
    }

    .hero__description {
      width: 100%;
      margin-block-start: 1.35rem;
      font-size: 1rem;
      line-height: 1.65;
    }

    .hero__description p + p {
      margin-block-start: 0.35rem;
    }

    .hero__actions {
      flex-direction: column;
      gap: 0.9rem;
      margin-block-start: 1.5rem;
    }

    .hero__button {
      width: 100%;
      min-height: 3.5rem;
      flex: none;
      font-size: 0.95rem;
    }

    .hero__visual {
      position: relative;
      inset: auto;
      display: flex;
      width: 100%;
      min-height: 0;
      flex-direction: column;
      align-items: center;
      gap: 1.6rem;
    }

    .hero__main-spark,
    .hero__character,
    .hero__speech,
    .hero__speech-spark {
      display: none;
    }

    .hero__laptop {
      position: relative;
      inset: auto;
      width: min(100%, 40rem);
    }

    .hero__laptop-lid {
      padding: 0.35rem;
      border-width: 3px;
      border-radius: 0.65rem 0.65rem 0.25rem 0.25rem;
    }

    .hero__laptop-base {
      border-width: 2px;
    }

    .hero__phone {
      position: relative;
      inset: auto;
      width: min(10.5rem, 46vw);
      padding: 0.3rem;
      border-width: 3px;
      border-radius: 1.45rem;
      box-shadow: var(--shadow-1);
    }

    .hero__product-caption {
      position: relative;
      inset: auto;
      order: 3;
      width: auto;
      font-size: 1.15rem;
    }
  }

  @media (max-width: 23rem) {
    .hero__headline {
      font-size: 2.05rem;
    }

    .hero__headline-accent {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__laptop,
    .hero__phone,
    .hero__character,
    .hero__speech,
    .hero__speech-spark {
      animation: none;
    }
  }
</style>
