---
import { getImage } from "astro:assets";
import desktopOverview from "../../assets/product-screenshots/hero/overview-desktop.jpg";
import mobileBooking from "../../assets/product-screenshots/hero/booking-mobile.jpg";
import productDesktopAr from "../../assets/generated/hero-v2/hero-product-desktop-ar.png";
import productDesktopEn from "../../assets/generated/hero-v2/hero-product-desktop-en.png";
import productMobileAr from "../../assets/generated/hero-v2/hero-product-mobile-ar-v2.png";
import productMobileEn from "../../assets/generated/hero-v2/hero-product-mobile-en.png";
import waterDesktopAr from "../../assets/generated/hero-v2/hero-water-desktop-ar.png";
import waterDesktopEn from "../../assets/generated/hero-v2/hero-water-desktop-en.png";
import waterMobile from "../../assets/generated/hero-v2/hero-water-mobile.png";
import stickerBlank from "../../assets/generated/hero-v2/hero-sticker-blank.png";
import headlineAccent from "../../assets/generated/hero/headline-accent-marks.png";

interface Props {
  locale: "ar" | "en";
}

const { locale } = Astro.props;
const isArabic = locale === "ar";

const copy = isArabic
  ? {
      eyebrow: "نظام إدارة متكامل لمغاسل السيارات",
      headline: ["مش لازم تفضل في", "المغسلة عشان تكون", "مسيطر عليها."],
      descriptionLead:
        "Sparkle Auto بيجمع تشغيل مغسلتك في مكان واحد: الحجوزات، حالة العربيات، الفريق، المخزون، الإيرادات والعملاء.",
      descriptionClose:
        "بدل المكالمات والتقارير المتفرقة: افتح واعرف إيه اللي بيحصل في مغسلتك حتى لو إنت بعيد.",
      primaryCta: "احجز مراجعة تشغيل لفروعك",
      secondaryCta: "شوف السيستم وهو شغال",
      microcopy:
        "مراجعة قصيرة نفهم فيها طريقة شغلك ونقولك بصراحة هل Sparkle Auto مناسب ليك ولا لأ.",
      productCaption: "مغسلتك في جيبك.",
      productFigureLabel:
        "Sparkle Auto على اللابتوب والموبايل مع شاشة الـOverview وشاشة الحجز الحقيقيتين",
      desktopAlt:
        "شاشة الـOverview الحقيقية في Sparkle Auto وتعرض الحجوزات والإيرادات وحالة تشغيل المغسلة",
      mobileAlt:
        "شاشة الحجز الحقيقية للعملاء في Sparkle Auto وتعرض اختيار التاريخ والموعد",
      arrow: "←",
    }
  : {
      eyebrow: "Complete Management System for Car Washes",
      headline: ["You don’t have to", "stay at the wash to", "stay in control."],
      descriptionLead:
        "Sparkle Auto brings your bookings, car status, team, inventory, revenue, and customers into one place.",
      descriptionClose:
        "Instead of scattered calls and reports: open the system and know what’s happening at your car wash — even when you’re away.",
      primaryCta: "Book an Operations Review",
      secondaryCta: "See the System in Action",
      microcopy:
        "A short review to understand how you operate and tell you honestly whether Sparkle Auto is the right fit for you.",
      productCaption: "Your car wash in your pocket.",
      productFigureLabel:
        "Sparkle Auto on laptop and phone with the real Overview and customer booking screens",
      desktopAlt:
        "The real Sparkle Auto Overview screen showing bookings, revenue, and car-wash operations",
      mobileAlt:
        "The real Sparkle Auto customer booking screen showing date and appointment selection",
      arrow: "→",
    };

const localeRoot = isArabic ? "/" : "/en/";
const desktopArtSource = isArabic ? productDesktopAr : productDesktopEn;
const mobileArtSource = isArabic ? productMobileAr : productMobileEn;
const desktopWaterSource = isArabic ? waterDesktopAr : waterDesktopEn;

const [desktopArt, mobileArt, desktopWater, mobileWaterArt, sticker, accent] = await Promise.all([
  getImage({ src: desktopArtSource, width: 1448, format: "webp", quality: 91 }),
  getImage({ src: mobileArtSource, width: 1254, format: "webp", quality: 91 }),
  getImage({ src: desktopWaterSource, width: 1672, format: "webp", quality: 90 }),
  getImage({ src: waterMobile, width: 941, format: "webp", quality: 90 }),
  getImage({ src: stickerBlank, width: 720, format: "webp", quality: 94 }),
  getImage({ src: headlineAccent, width: 160, format: "webp", quality: 100 }),
]);
---

<section class="hero" data-locale={locale} aria-labelledby="hero-title">
  <picture class="hero__water" aria-hidden="true">
    <source media="(max-width: 67.5rem)" srcset={mobileWaterArt.src} />
    <img
      src={desktopWater.src}
      alt=""
      width={desktopWater.attributes.width}
      height={desktopWater.attributes.height}
      loading="eager"
      fetchpriority="low"
      decoding="async"
    />
  </picture>

  <div class="hero__inner">
    <div class="hero__content" dir={isArabic ? "rtl" : "ltr"}>
      <p class="hero__eyebrow">{copy.eyebrow}</p>

      <div class="hero__headline-wrap">
        <h1 class="hero__headline" id="hero-title">
          {copy.headline.map((line, index) => (
            <span class:list={{ "hero__headline-highlight": index === copy.headline.length - 1 }}>
              {line}{index < copy.headline.length - 1 ? " " : ""}
            </span>
          ))}
        </h1>
        <img
          class="hero__headline-accent"
          src={accent.src}
          alt=""
          width="44"
          height="50"
          loading="eager"
          decoding="async"
          aria-hidden="true"
        />
      </div>

      <div class="hero__description">
        <p>{copy.descriptionLead}</p>
        <p>{copy.descriptionClose}</p>
      </div>

      <div class="hero__actions">
        <a class="hero__button hero__button--primary" href={`${localeRoot}#application`}>
          {copy.primaryCta}
        </a>
        <a class="hero__button hero__button--secondary" href="#hero-product">
          <span>{copy.secondaryCta}</span>
          <span class="hero__button-arrow" aria-hidden="true">{copy.arrow}</span>
        </a>
      </div>

      <aside class="hero__microcopy" aria-label={isArabic ? "معلومات مراجعة التشغيل" : "Operations review note"}>
        <span class="hero__microcopy-icon" aria-hidden="true">
          <svg viewBox="0 0 48 48" focusable="false">
            <circle cx="24" cy="24" r="24" fill="currentColor"></circle>
            <path d="M24 9.5 35 14v9.2c0 7.2-4.4 12.4-11 15.3-6.6-2.9-11-8.1-11-15.3V14Z" fill="#fff"></path>
            <path d="m18.5 23.8 3.6 3.7 7.7-8" fill="none" stroke="#0796F6" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </span>
        <p>
          {isArabic ? (
            <>
              مراجعة قصيرة نفهم فيها طريقة شغلك ونقولك بصراحة هل{" "}
              <bdi dir="ltr">Sparkle Auto</bdi>{" "}
              مناسب ليك ولا لأ.
            </>
          ) : (
            copy.microcopy
          )}
        </p>
      </aside>
    </div>

    <figure class="hero__visual" id="hero-product" aria-label={copy.productFigureLabel}>
      <div class="hero__product-stage">
        <picture class="hero__product-art" aria-hidden="true">
          <source media="(max-width: 67.5rem)" srcset={mobileArt.src} />
          <img
            src={desktopArt.src}
            alt=""
            width={desktopArt.attributes.width}
            height={desktopArt.attributes.height}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>

        <img
          class="hero__screen hero__screen--laptop"
          src={desktopOverview.src}
          alt={copy.desktopAlt}
          width={desktopOverview.width}
          height={desktopOverview.height}
          loading="eager"
          decoding="async"
        />

        <img
          class="hero__screen hero__screen--phone"
          src={mobileBooking.src}
          alt={copy.mobileAlt}
          width={mobileBooking.width}
          height={mobileBooking.height}
          loading="eager"
          decoding="async"
        />

        <div class="hero__sticker" role="note" aria-label={copy.productCaption}>
          <span class="hero__sticker-crop" aria-hidden="true">
            <img src={sticker.src} alt="" width="242" height="162" loading="eager" decoding="async" />
          </span>
          <span class="hero__sticker-copy">{copy.productCaption}</span>
        </div>
      </div>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: calc(100svh - 7rem);
    min-height: 43rem;
    overflow: hidden;
    background: #fcfeff;
    isolation: isolate;
  }

  .hero__water {
    position: absolute;
    z-index: 0;
    inset-inline: 0;
    inset-block-start: -7rem;
    display: block;
    width: 100%;
    pointer-events: none;
    user-select: none;
  }

  .hero__water img {
    display: block;
    width: 100%;
    height: auto;
    opacity: 0.78;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    width: min(calc(100% - 8rem), 88rem);
    height: 100%;
    margin-inline: auto;
    grid-template-columns: minmax(29rem, 36%) minmax(0, 64%);
    grid-template-areas: "copy visual";
    direction: ltr;
  }

  .hero[data-locale="ar"] .hero__inner {
    grid-template-areas: "visual copy";
    grid-template-columns: minmax(0, 64%) minmax(29rem, 36%);
  }

  .hero__content {
    z-index: 5;
    grid-area: copy;
    width: min(100%, 32.8125rem);
    padding-block-start: 2.375rem;
  }

  .hero[data-locale="ar"] .hero__content {
    justify-self: end;
  }

  .hero__eyebrow {
    display: inline-flex;
    min-height: 2.5625rem;
    align-items: center;
    margin: 0;
    padding: 0.4rem 0.9rem;
    border: 2px solid #0796f6;
    border-radius: 0.375rem;
    background: #fff;
    box-shadow: 4px 4px 0 #03132e;
    color: #0064ad;
    font-size: clamp(0.875rem, 0.68rem + 0.35vw, 1.125rem);
    font-weight: 800;
    line-height: 1.15;
    white-space: nowrap;
  }

  .hero[data-locale="en"] .hero__eyebrow {
    width: 27.5rem;
    justify-content: center;
  }

  .hero__headline-wrap {
    position: relative;
    width: 100%;
    margin-block-start: 1.25rem;
  }

  .hero__headline {
    width: 32.8125rem;
    max-width: none;
    margin: 0;
    color: #03132e;
    font-size: clamp(3.4375rem, 4.1vw, 3.9375rem);
    font-weight: 900;
    letter-spacing: -0.035em;
    line-height: 0.95;
    text-wrap: balance;
  }

  .hero[data-locale="ar"] .hero__headline {
    font-size: clamp(3.25rem, 3.9vw, 3.75rem);
    letter-spacing: 0;
    line-height: 1.02;
  }

  .hero__headline > span {
    display: block;
    white-space: nowrap;
  }

  .hero__headline-highlight {
    color: #0796f6;
  }

  .hero__headline-accent {
    position: absolute;
    z-index: 2;
    inset-block-start: -0.1rem;
    left: calc(100% - 0.35rem);
    display: block;
    width: 2.75rem;
    height: 3.125rem;
    object-fit: contain;
    pointer-events: none;
  }

  .hero[data-locale="ar"] .hero__headline-accent {
    inset-block-start: 0.15rem;
    right: auto;
    left: 1.25rem;
    width: 2.4rem;
    height: 2.75rem;
  }

  .hero__description {
    width: min(100%, 31.25rem);
    margin-block-start: 1.25rem;
    color: #0c264b;
    font-size: clamp(1rem, 0.82rem + 0.34vw, 1.1875rem);
    font-weight: 500;
    line-height: 1.3;
  }

  .hero__description p {
    margin: 0;
  }

  .hero__description p + p {
    margin-block-start: 0.05rem;
  }

  .hero__actions {
    display: flex;
    width: 31.1875rem;
    max-width: 100%;
    align-items: stretch;
    gap: 1.6875rem;
    margin-block-start: 2.25rem;
  }

  .hero__button {
    display: inline-flex;
    min-height: 3.5rem;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding-inline: 0.85rem;
    border: 2px solid #03132e;
    border-radius: 0.375rem;
    box-shadow: 5px 5px 0 #03132e;
    font-size: 1rem;
    font-weight: 850;
    line-height: 1.15;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform var(--motion-micro) var(--ease-standard),
      box-shadow var(--motion-micro) var(--ease-standard),
      background-color var(--motion-micro) var(--ease-standard);
  }

  .hero__button--primary {
    width: 15rem;
    background: #0796f6;
    color: #fff;
  }

  .hero__button--secondary {
    width: 14.5rem;
    background: #fff;
    color: #03132e;
  }

  .hero__button:hover {
    transform: translate(-1px, -1px);
  }

  .hero__button--primary:hover {
    background: #007ed5;
  }

  .hero__button:active {
    box-shadow: 1px 1px 0 #03132e;
    transform: translate(4px, 4px) scale(0.995);
  }

  .hero__button:focus-visible {
    outline: 3px solid #0796f6;
    outline-offset: 4px;
  }

  .hero__button--primary:focus-visible {
    outline-color: #03132e;
  }

  .hero__button-arrow {
    font-family: "Nunito Variable", Nunito, system-ui, sans-serif;
    font-size: 1.45rem;
    font-weight: 900;
    line-height: 1;
  }

  .hero__microcopy {
    display: grid;
    width: 31.125rem;
    min-height: 5.8125rem;
    max-width: 100%;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    align-items: center;
    gap: 0.9rem;
    margin-block-start: 1.4375rem;
    padding: 0.75rem 1rem;
    border: 2px solid #03132e;
    border-radius: 0.4375rem;
    background: #fff;
    box-shadow: 5px 5px 0 #03132e;
    color: #0c264b;
  }

  .hero[data-locale="ar"] .hero__microcopy {
    grid-template-columns: minmax(0, 1fr) 3.25rem;
  }

  .hero__microcopy-icon {
    display: block;
    width: 3.25rem;
    height: 3.25rem;
    color: #0796f6;
  }

  .hero[data-locale="ar"] .hero__microcopy-icon {
    grid-column: 2;
    grid-row: 1;
  }

  .hero[data-locale="ar"] .hero__microcopy p {
    grid-column: 1;
    grid-row: 1;
  }

  .hero__microcopy svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__microcopy p {
    margin: 0;
    font-size: 0.94rem;
    font-weight: 750;
    line-height: 1.35;
  }

  .hero__visual {
    position: relative;
    z-index: 2;
    grid-area: visual;
    min-width: 0;
    height: 100%;
    margin: 0;
  }

  .hero__product-stage {
    --laptop-x: 8.63%;
    --laptop-y: 31.31%;
    --laptop-w: 58.56%;
    --laptop-h: 43.92%;
    --phone-x: 61.60%;
    --phone-y: 49.26%;
    --phone-w: 14.71%;
    --phone-h: 34.90%;
    position: absolute;
    inset-block-start: -1.125rem;
    left: -1.5rem;
    width: calc(100% + 5.5rem);
    max-width: 61.875rem;
    aspect-ratio: 4 / 3;
    filter: drop-shadow(0 0.7rem 0.65rem rgb(3 19 46 / 8%));
    animation: hero-product-in 580ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .hero[data-locale="ar"] .hero__product-stage {
    --laptop-x: 36.88%;
    --laptop-y: 33.15%;
    --laptop-w: 55.39%;
    --laptop-h: 41.53%;
    --phone-x: 22.51%;
    --phone-y: 47.88%;
    --phone-w: 13.81%;
    --phone-h: 32.78%;
    left: -4rem;
    width: calc(100% + 4rem);
    max-width: 60.3125rem;
  }

  .hero__product-art,
  .hero__product-art img {
    position: absolute;
    z-index: 1;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__product-art img {
    object-fit: contain;
  }

  .hero__screen {
    position: absolute;
    z-index: 2;
    display: block;
    background: #fff;
    object-fit: contain;
  }

  .hero__screen--laptop {
    top: var(--laptop-y);
    left: var(--laptop-x);
    width: var(--laptop-w);
    height: var(--laptop-h);
  }

  .hero__screen--phone {
    top: var(--phone-y);
    left: var(--phone-x);
    width: var(--phone-w);
    height: var(--phone-h);
    border-radius: 5.5% / 3.2%;
  }

  .hero__sticker {
    position: absolute;
    z-index: 4;
    inset-block-start: 2.2rem;
    inset-inline-end: 0.6rem;
    width: 9.375rem;
    height: 6rem;
    animation: hero-sticker-in 460ms 180ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .hero[data-locale="ar"] .hero__sticker {
    inset-inline-start: 21rem;
    inset-inline-end: auto;
  }

  .hero__sticker-crop {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
  }

  .hero__sticker-crop img {
    position: absolute;
    top: -2rem;
    left: -2.8125rem;
    display: block;
    width: 15.125rem;
    max-width: none;
    height: 10.125rem;
  }

  .hero__sticker-copy {
    position: absolute;
    z-index: 1;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 0.8rem 0.75rem 1.25rem;
    color: #03132e;
    font-size: 1rem;
    font-weight: 900;
    line-height: 1.08;
    text-align: center;
    text-wrap: balance;
    transform: rotate(-1deg);
  }

  @keyframes hero-product-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem) scale(0.99);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes hero-sticker-in {
    from {
      opacity: 0;
      transform: translateY(0.5rem) rotate(-2deg);
    }
    to {
      opacity: 1;
      transform: translateY(0) rotate(0);
    }
  }

  @media (max-width: 82.5rem) and (min-width: 67.5625rem) {
    .hero__inner {
      width: min(calc(100% - 6rem), 88rem);
      grid-template-columns: minmax(27.5rem, 39%) minmax(0, 61%);
    }

    .hero[data-locale="ar"] .hero__inner {
      grid-template-columns: minmax(0, 61%) minmax(27.5rem, 39%);
    }

    .hero__content {
      padding-block-start: 2rem;
    }

    .hero__headline {
      width: 29rem;
      font-size: clamp(3.15rem, 4.15vw, 3.55rem);
    }

    .hero[data-locale="ar"] .hero__headline {
      font-size: clamp(3rem, 3.9vw, 3.35rem);
    }

    .hero__description {
      font-size: 1rem;
    }

    .hero__actions {
      width: min(100%, 29rem);
      gap: 1rem;
    }

    .hero__button--primary,
    .hero__button--secondary {
      width: calc(50% - 0.5rem);
      font-size: 0.88rem;
    }

    .hero__microcopy {
      width: min(100%, 29rem);
    }
  }

  @media (max-width: 67.5rem) {
    .hero {
      height: auto;
      min-height: 0;
      overflow: clip;
      padding-block-end: 0;
    }

    .hero__water {
      inset-block-start: auto;
      inset-block-end: 0;
      inset-inline-start: -17.5%;
      width: 135%;
    }

    .hero__water img {
      width: 100%;
      opacity: 0.72;
    }

    .hero__inner,
    .hero[data-locale="ar"] .hero__inner {
      display: grid;
      width: min(calc(100% - 2.5rem), 43.1875rem);
      height: auto;
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "copy"
        "visual";
    }

    .hero__content,
    .hero[data-locale="ar"] .hero__content {
      width: 100%;
      justify-self: stretch;
      padding-block-start: clamp(1.9rem, 6vw, 3rem);
      text-align: center;
    }

    .hero__eyebrow {
      width: min(100%, 28rem);
      max-width: 100%;
      min-height: 2.75rem;
      justify-content: center;
      padding-inline: 0.8rem;
      font-size: clamp(0.82rem, 2.5vw, 1.05rem);
      white-space: normal;
    }

    .hero__headline-wrap {
      width: min(100%, 37rem);
      margin-block-start: 1.5rem;
      margin-inline: auto;
    }

    .hero__headline,
    .hero[data-locale="ar"] .hero__headline {
      width: 100%;
      font-size: clamp(2.55rem, 7.4vw, 3.55rem);
      letter-spacing: -0.025em;
      line-height: 1.02;
    }

    .hero[data-locale="ar"] .hero__headline {
      letter-spacing: 0;
      line-height: 1.08;
    }

    .hero__headline-accent {
      inset-block-start: -0.25rem;
      right: -0.4rem;
      left: auto;
      width: 2.4rem;
      height: 2.75rem;
    }

    .hero[data-locale="ar"] .hero__headline-accent {
      inset-block-start: 0;
      right: auto;
      left: -0.25rem;
    }

    .hero__description {
      width: min(100%, 35rem);
      margin-block-start: 1.4rem;
      margin-inline: auto;
      font-size: clamp(1rem, 2.75vw, 1.15rem);
      line-height: 1.45;
    }

    .hero__description p + p {
      margin-block-start: 0.45rem;
    }

    .hero__actions {
      width: min(100%, 35rem);
      flex-direction: column;
      gap: 1rem;
      margin-block-start: 1.65rem;
      margin-inline: auto;
    }

    .hero__button,
    .hero__button--primary,
    .hero__button--secondary {
      width: 100%;
      min-height: 3.5rem;
      font-size: 1rem;
    }

    .hero__microcopy,
    .hero[data-locale="ar"] .hero__microcopy {
      width: min(100%, 35rem);
      min-height: 5.75rem;
      margin-block-start: 1.25rem;
      margin-inline: auto;
      text-align: start;
    }

    .hero__visual {
      height: auto;
      margin-block-start: 2.1rem;
    }

    .hero__product-stage,
    .hero[data-locale="ar"] .hero__product-stage {
