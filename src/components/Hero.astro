---
import { Image } from "astro:assets";
import desktopOverview from "../../assets/product-screenshots/hero/overview-desktop.jpg";
import mobileBooking from "../../assets/product-screenshots/hero/booking-mobile.jpg";
import heroCharacter from "../../assets/generated/hero/hero-character.png";
import heroWater from "../../assets/generated/hero/hero-water-background.png";
import heroWaterMobile from "../../assets/generated/hero/hero-water-background-mobile.png";
import headlineAccent from "../../assets/generated/hero/headline-accent-marks.png";
import mainSpark from "../../assets/generated/hero/hero-main-spark.png";
import speechBubble from "../../assets/generated/hero/speech-bubble-shape.png";
import speechBubbleSpark from "../../assets/generated/hero/speech-bubble-spark.png";

interface Props {
  locale: "ar" | "en";
}

const { locale } = Astro.props;
const isArabic = locale === "ar";

const copy = isArabic
  ? {
      eyebrow: "نظام إدارة متكامل لمغاسل السيارات",
      headline: ["مش لازم تفضل", "في المغسلة عشان", "تكون مسيطر عليها."],
      descriptionLead:
        "Sparkle Auto بيجمع تشغيل مغسلتك في مكان واحد: الحجوزات، حالة العربيات، الفريق، المخزون، الإيرادات والعملاء.",
      descriptionPivot: "بدل المكالمات والتقارير المتفرقة:",
      descriptionClose: "افتح واعرف إيه اللي بيحصل في مغسلتك حتى لو إنت بعيد.",
      primaryCta: "احجز مراجعة تشغيل لفروعك",
      secondaryCta: "شوف السيستم وهو شغال",
      productCaption: "مغسلتك في جيبك.",
      desktopAlt:
        "شاشة الـOverview الحقيقية في Sparkle Auto وتعرض الحجوزات والإيرادات وحالة تشغيل المغسلة",
      mobileAlt: "شاشة الحجز الحقيقية للعملاء في Sparkle Auto وتعرض اختيار التاريخ والموعد",
    }
  : {
      eyebrow: "Complete Management System for Car Washes",
      headline: ["You don’t have to", "stay at the wash to", "stay in control."],
      descriptionLead:
        "Sparkle Auto brings your bookings, car status, team, inventory, revenue, and customers into one place.",
      descriptionPivot: "Instead of scattered calls and reports:",
      descriptionClose:
        "Open the system and know what's happening at your car wash — even when you're away.",
      primaryCta: "Book an Operations Review",
      secondaryCta: "See the System in Action",
      productCaption: "Your car wash in your pocket.",
      desktopAlt:
        "The real Sparkle Auto Overview screen showing bookings, revenue, and car-wash operations",
      mobileAlt:
        "The real Sparkle Auto customer booking screen showing date and appointment selection",
    };

const localeRoot = isArabic ? "/" : "/en/";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__water-stage" aria-hidden="true">
    <div class="hero__water-piece hero__water-piece--main">
      <img src={heroWater.src} alt="" width={heroWater.width} height={heroWater.height} loading="eager" fetchpriority="high" decoding="async" />
    </div>
    <div class="hero__water-piece hero__water-piece--left">
      <img src={heroWater.src} alt="" width={heroWater.width} height={heroWater.height} loading="lazy" decoding="async" />
    </div>
    <div class="hero__water-piece hero__water-piece--right">
      <img src={heroWater.src} alt="" width={heroWater.width} height={heroWater.height} loading="lazy" decoding="async" />
    </div>
    <div class="hero__water-piece hero__water-piece--halftone">
      <img src={heroWater.src} alt="" width={heroWater.width} height={heroWater.height} loading="lazy" decoding="async" />
    </div>
  </div>

  <picture class="hero__water-mobile" aria-hidden="true">
    <img
      src={heroWaterMobile.src}
      alt=""
      width={heroWaterMobile.width}
      height={heroWaterMobile.height}
      loading="lazy"
      decoding="async"
    />
  </picture>

  <div class="hero__canvas">
    <div class="hero__content" dir={isArabic ? "rtl" : "ltr"}>
      <p class="hero__eyebrow">{copy.eyebrow}</p>

      <div class="hero__headline-wrap">
        <h1 class="hero__headline" id="hero-title">
          <span>{copy.headline[0]}</span>
          <span>{copy.headline[1]}</span>
          <span class="hero__headline-highlight">{copy.headline[2]}</span>
        </h1>
        <Image
          class="hero__headline-accent"
          src={headlineAccent}
          alt=""
          format="webp"
          quality={100}
          loading="eager"
          decoding="async"
          aria-hidden="true"
        />
      </div>

      <div class="hero__description">
        <p>{copy.descriptionLead}</p>
        <p><strong>{copy.descriptionPivot}</strong></p>
        <p>{copy.descriptionClose}</p>
      </div>

      <div class="hero__actions">
        <a class="hero__button hero__button--primary" href={`${localeRoot}#application`} dir={isArabic ? "rtl" : "ltr"}>
          {copy.primaryCta}
        </a>
        <a class="hero__button hero__button--secondary" href="#hero-product" dir={isArabic ? "rtl" : "ltr"}>
          <span>{copy.secondaryCta}</span>
          <span class="hero__button-arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <div class="hero__trust" role="group" aria-labelledby={`hero-trust-title-${locale}`} dir="ltr">
        <svg class="hero__trust-shield" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
          <circle cx="24" cy="24" r="24" fill="#01A2FF"></circle>
          <path d="M24 9.5 35 14v9.2c0 7.2-4.4 12.4-11 15.3-6.6-2.9-11-8.1-11-15.3V14Z" fill="#fff"></path>
          <path d="m18.5 23.8 3.6 3.7 7.7-8" fill="none" stroke="#01A2FF" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <p class="hero__trust-title" id={`hero-trust-title-${locale}`}>Built for car wash owners in Egypt</p>
        <ul class="hero__trust-list">
          {[
            "Easy to use",
            "Works on any device",
            "Local support",
          ].map((item) => (
            <li>
              <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <circle cx="8" cy="8" r="6.5" fill="none" stroke="#01A2FF"></circle>
                <path d="m5 8 2 2 4-4" fill="none" stroke="#01A2FF" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <figure class="hero__visual" id="hero-product" aria-label={copy.productCaption}>
      <Image
        class="hero__main-spark"
        src={mainSpark}
        alt=""
        format="webp"
        quality={100}
        loading="lazy"
        decoding="async"
        aria-hidden="true"
      />

      <div class="hero__laptop">
        <div class="hero__laptop-lid">
          <Image
            class="hero__desktop-screen"
            src={desktopOverview}
            alt={copy.desktopAlt}
            format="webp"
            quality={94}
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="hero__laptop-base" aria-hidden="true">
          <span></span>
        </div>
      </div>

      <Image
        class="hero__character"
        src={heroCharacter}
        alt=""
        format="webp"
        quality={94}
        loading="lazy"
        decoding="async"
        aria-hidden="true"
      />

      <div class="hero__phone">
        <span class="hero__phone-speaker" aria-hidden="true"></span>
        <Image
          class="hero__mobile-screen"
          src={mobileBooking}
          alt={copy.mobileAlt}
          format="webp"
          quality={94}
          loading="eager"
          decoding="async"
        />
      </div>

      <div class="hero__speech" role="img" aria-label="Run it Smarter.">
        <Image
          class="hero__speech-shape"
          src={speechBubble}
          alt=""
          format="webp"
          quality={100}
          loading="lazy"
          decoding="async"
          aria-hidden="true"
        />
        <span class="hero__speech-copy" aria-hidden="true">Run it<br />Smarter.</span>
      </div>

      <Image
        class="hero__speech-spark"
        src={speechBubbleSpark}
        alt=""
        format="webp"
        quality={100}
        loading="lazy"
        decoding="async"
        aria-hidden="true"
      />
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 0;
    margin-block-start: -7rem;
    overflow: hidden;
    background: #fcfeff;
    isolation: isolate;
  }

  .hero__water-stage,
  .hero__water-mobile {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    user-select: none;
  }

  .hero__water-mobile {
    display: none;
  }

  .hero__water-piece {
    position: absolute;
    overflow: hidden;
  }

  .hero__water-piece img {
    position: absolute;
    display: block;
    width: 1536px;
    max-width: none;
    height: 864px;
  }

  .hero__water-piece--main {
    top: 150px;
    left: calc(50% - 178px);
    width: 635px;
    height: 430px;
    opacity: 0.78;
  }

  .hero__water-piece--main img {
    top: -167px;
    left: -595px;
  }

  .hero__water-piece--left {
    top: 730px;
    left: 0;
    width: 175px;
    height: 134px;
    opacity: 0.64;
  }

  .hero__water-piece--left img {
    top: -700px;
    left: 0;
  }

  .hero__water-piece--right {
    top: 740px;
    left: calc(50% + 607px);
    width: 161px;
    height: 124px;
    opacity: 0.64;
  }

  .hero__water-piece--right img {
    top: -721px;
    left: -1383px;
  }

  .hero__water-piece--halftone {
    top: 190px;
    left: calc(50% + 612px);
    width: 156px;
    height: 335px;
    opacity: 0.48;
  }

  .hero__water-piece--halftone img {
    top: -190px;
    left: -1380px;
  }

  .hero__canvas {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 96rem;
    height: 100%;
    min-height: 0;
    margin-inline: auto;
    direction: ltr;
  }

  .hero__content {
    position: absolute;
    z-index: 12;
    top: 150px;
    left: 64px;
    display: flex;
    width: 525px;
    flex-direction: column;
    align-items: flex-start;
    color: var(--deep-navy);
    text-align: start;
  }

  .hero__eyebrow {
    display: inline-flex;
    width: 440px;
    height: 41px;
    box-sizing: border-box;
    align-items: center;
    margin: 0;
    padding: 0 13px;
    border: 2px solid var(--spark-blue);
    border-radius: 6px;
    background: var(--white);
    box-shadow: 4px 4px 0 var(--deep-navy);
    color: #0064ad;
    font-size: 18px;
    font-weight: 800;
    line-height: 1.2;
    white-space: nowrap;
  }

  .hero__headline-wrap {
    position: relative;
    width: 100%;
  }

  .hero__headline {
    margin: 20px 0 0;
    color: var(--deep-navy);
    font-size: 63px;
    font-weight: 900;
    letter-spacing: -0.035em;
    line-height: 0.95;
  }

  .hero__headline span {
    display: block;
    white-space: nowrap;
  }

  html[lang="en"] .hero__headline span:nth-child(1) {
    transform: scaleX(0.99);
    transform-origin: left center;
  }

  html[lang="en"] .hero__headline span:nth-child(2) {
    transform: scaleX(0.925);
    transform-origin: left center;
  }

  html[lang="ar"] .hero__headline {
    letter-spacing: 0;
    text-align: right;
  }

  html[lang="ar"] .hero__headline span:nth-child(2) {
    transform: scaleX(0.965);
    transform-origin: right center;
  }

  html[lang="ar"] .hero__headline span:nth-child(3) {
    transform: scaleX(0.87);
    transform-origin: right center;
  }

  .hero__headline-highlight {
    color: var(--spark-blue);
    letter-spacing: -0.01em;
  }

  .hero__headline-accent {
    position: absolute;
    z-index: 13;
    top: 19px;
    left: 502px;
    width: 44px;
    height: 50px;
    object-fit: fill;
    pointer-events: none;
  }

  .hero__description {
    width: 500px;
    margin-block-start: 20px;
    color: #0c264b;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.3;
  }

  .hero__description p {
    margin: 0;
  }

  .hero__description p + p {
    margin-block-start: 0;
  }

  .hero__description strong {
    color: inherit;
    font-weight: 500;
  }

  .hero__actions {
    position: absolute;
    top: 413px;
    left: 0;
    display: flex;
    width: 499px;
    height: 56px;
    align-items: stretch;
    gap: 27px;
    margin: 0;
    direction: ltr;
  }

  .hero__button {
    display: inline-flex;
    height: 56px;
    min-height: 56px;
    flex: none;
    box-sizing: border-box;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 0 14px;
    border: 2px solid var(--deep-navy);
    border-radius: 6px;
    color: var(--deep-navy);
    font-size: 16px;
    font-weight: 850;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform var(--motion-micro) var(--ease-standard),
      box-shadow var(--motion-micro) var(--ease-standard),
      background-color var(--motion-micro) var(--ease-standard);
  }

  .hero__button--primary {
    width: 240px;
    background: var(--spark-blue);
    box-shadow: 5px 5px 0 var(--deep-navy);
    color: var(--deep-navy);
  }

  .hero__button--secondary {
    width: 232px;
    background: var(--white);
    box-shadow: 5px 5px 0 var(--deep-navy);
  }

  .hero__button:hover {
    background: var(--fresh-blue);
    transform: translate(-1px, -1px);
  }

  .hero__button:active {
    box-shadow: none;
    transform: translate(4px, 4px);
  }

  .hero__button:focus-visible {
    outline: 3px solid var(--deep-navy);
    outline-offset: 4px;
  }

  .hero__button-arrow {
    font-family: "Nunito Variable", Nunito, system-ui, sans-serif;
    font-size: 1.5em;
    line-height: 0;
  }

  .hero__trust {
    position: absolute;
    z-index: 13;
    top: 494px;
    left: 0;
    display: grid;
    width: 498px;
    height: 93px;
    box-sizing: border-box;
    grid-template-columns: 52px minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: 13px;
    padding: 12px 14px 11px 12px;
    border: 2px solid #03132e;
    border-radius: 7px;
    background: #fff;
    box-shadow: 5px 5px 0 #03132e;
    color: #03132e;
    font-family: "Nunito Variable", Nunito, system-ui, sans-serif;
    text-align: left;
  }

  .hero__trust-shield {
    grid-row: 1 / 3;
    width: 52px;
    height: 52px;
    align-self: start;
    margin-block-start: 1px;
  }

  .hero__trust-title {
    margin: 0;
    font-size: 18px;
    font-weight: 900;
    line-height: 1.15;
    white-space: nowrap;
  }

  .hero__trust-list {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin: 8px 0 0;
    padding: 0;
    color: #0c264b;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.2;
    list-style: none;
    white-space: nowrap;
  }

  .hero__trust-list li {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .hero__trust-list svg {
    width: 16px;
    height: 16px;
    flex: none;
  }

  .hero__visual {
    position: absolute;
    z-index: 2;
    inset: 0;
    margin: 0;
    direction: ltr;
    pointer-events: none;
  }

  .hero__main-spark {
    position: absolute;
    z-index: 4;
    top: 133px;
    left: 1118px;
    width: 34px;
    height: 50px;
    object-fit: fill;
  }

  .hero__laptop {
    position: absolute;
    z-index: 5;
    top: 296px;
    left: 583px;
    width: 680px;
    animation: hero-stage-in 620ms var(--ease-standard) both;
  }

  .hero__laptop-lid {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 1.74;
    padding: 8px;
    border: 1px solid #111827;
    border-radius: 10px 10px 3px 3px;
    background: #101827;
  }

  .hero__desktop-screen {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 4px;
    object-fit: cover;
    object-position: center;
  }

  .hero__laptop-base {
    position: relative;
    width: 100%;
    height: 42px;
    border: 1px solid #a5afb9;
    border-block-start-color: #f8fafc;
    border-radius: 2px 2px 14px 14px;
    background: #d9e0e6;
    box-shadow: 0 8px 12px rgb(3 19 46 / 12%);
    clip-path: polygon(0 0, 100% 0, 98.7% 100%, 1.3% 100%);
  }

  .hero__laptop-base span {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 43%;
    width: 14%;
    height: 9px;
    border: 1px solid #a5afb9;
    border-block-start: 0;
    border-radius: 0 0 6px 6px;
    background: #eef2f5;
  }

  .hero__character {
    position: absolute;
    z-index: 6;
    top: 86px;
    left: 1092px;
    width: 360px;
    height: auto;
    object-fit: contain;
    animation: hero-stage-in 620ms 90ms var(--ease-standard) both;
  }

  .hero__phone {
    position: absolute;
    z-index: 8;
    top: 422px;
    left: 1158px;
    overflow: hidden;
    width: 149px;
    height: 352px;
    padding: 5px;
    border: 3px solid #071a3f;
    border-radius: 25px;
    background: #071a3f;
    box-shadow: 3px 4px 0 rgb(3 19 46 / 85%);
    animation: hero-stage-in 620ms 140ms var(--ease-standard) both;
  }

  .hero__phone-speaker {
    position: absolute;
    z-index: 2;
    inset-block-start: 0.55rem;
    inset-inline-start: 50%;
    width: 34%;
    height: 0.5rem;
    border-radius: 999px;
    background: #071a3f;
    transform: translateX(-50%);
  }

  .hero__mobile-screen {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 1.15rem;
    object-fit: cover;
    object-position: center top;
  }

  .hero__speech {
    position: absolute;
    z-index: 9;
    top: 113px;
    left: 1365px;
    width: 132px;
    height: 82px;
    animation: hero-sticker-in 420ms 260ms var(--ease-standard) both;
  }

  .hero__speech-shape {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: fill;
  }

  .hero__speech-copy {
    position: absolute;
    z-index: 1;
    inset-block-start: 21%;
    inset-inline: 12% 8%;
    color: #03132e;
    direction: ltr;
    font-family: "Nunito Variable", Nunito, system-ui, sans-serif;
    font-size: clamp(0.7rem, 1.3vw, 1.25rem);
    font-weight: 950;
    letter-spacing: -0.045em;
    line-height: 0.9;
    text-align: center;
  }

  .hero__speech-spark {
    position: absolute;
    z-index: 11;
    top: 108px;
    left: 1468px;
    width: 28px;
    height: 37px;
    object-fit: fill;
    animation: hero-sticker-in 420ms 330ms var(--ease-standard) both;
  }

  @keyframes hero-stage-in {
    from {
      opacity: 0;
      transform: translateY(1rem) scale(0.985);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes hero-sticker-in {
    from {
      opacity: 0;
      transform: translateY(0.35rem) rotate(-2deg);
    }
    to {
      opacity: 1;
      transform: translateY(0) rotate(0);
    }
  }

  @media (min-width: 56.01rem) and (max-width: 75rem) {
    .hero {
      min-height: 56.25vw;
    }

    .hero__canvas {
      min-height: 56.25vw;
    }

    .hero__eyebrow {
      min-height: 2.35rem;
    }

    .hero__actions {
      gap: 0.9rem;
      margin-block-start: 0.85rem;
    }

    .hero__button {
      min-height: 3.2rem;
      padding-inline: 0.55rem;
    }

    .hero__description {
      margin-block-start: 0.8rem;
      line-height: 1.32;
    }
  }

  @media (max-width: 75rem) {
    .hero {
      height: auto;
      min-height: auto;
      margin-block-start: -7rem;
      padding-block-start: 7rem;
    }

    .hero__water-stage {
      display: none;
    }

    .hero__water-mobile {
      display: block;
    }

    .hero__water-mobile img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: fill;
    }

    .hero__canvas {
      display: flex;
      min-height: 0;
      flex-direction: column;
      gap: 2rem;
      padding: 1.5rem 1.25rem 3rem;
    }

    .hero__content {
      position: relative;
      inset: auto;
      width: 100%;
      max-width: 40rem;
      margin-inline: auto;
    }

    .hero__eyebrow {
      min-height: 2.75rem;
      max-width: 100%;
      font-size: 0.88rem;
      white-space: normal;
    }

    .hero__headline {
      margin-block-start: 1.1rem;
      font-size: clamp(2.25rem, 10.8vw, 3.25rem);
      line-height: 1.1;
    }

    .hero__headline span,
    html[lang="ar"] .hero__headline span:nth-child(2),
    html[lang="ar"] .hero__headline span:nth-child(3) {
      white-space: normal;
      transform: none;
    }

    .hero__headline-accent {
      inset-block-start: 0.25rem;
      inset-inline-start: auto;
      inset-inline-end: -0.25rem;
      width: 2rem;
      height: 2.25rem;
    }

    .hero__description {
      width: 100%;
      margin-block-start: 1.35rem;
      font-size: 1rem;
